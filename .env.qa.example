services:

  database:
    image: YOUR_DATABASE_IMAGE
    container_name: firemex-qa-db
    restart: unless-stopped

    environment:
      # QA database configuration
      # Use secrets/environment variables
      ...

    volumes:
      - qa_database_data:/var/lib/...

    networks:
      - firemex-qa


  homeassistant:
    image: YOUR_HOME_ASSISTANT_IMAGE
    container_name: firemex-qa-homeassistant
    restart: unless-stopped

    depends_on:
      - database

    ports:
      - "8124:8123"

    environment:
      # QA configuration
      ...

    networks:
      - firemex-qa


volumes:
  qa_database_data:


networks:
  firemex-qa: